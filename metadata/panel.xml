<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="panel">
	<group>
	  <option name="widgets_left" type="string">
		<default>smenu spacing0 spacing4 launchers spacing8 window-list</default>
	  </option>
	  <option name="widgets_right" type="string">
		<default>tray power ejecter updater spacing2 connect spacing2 bluetooth spacing2 netman spacing2 volumepulse spacing2 clock spacing2 batt spacing2 squeek</default>
	  </option>
	  <option name="icon_size" type="int">
		<default>32</default>
	  </option>
	  <option name="layer" type="string">
		<default>bottom</default>
	  </option>
	  <option name="monitor" type="string">
		<default>0</default>
	  </option>
	  <option name="position" type="string">
		<default>top</default>
	  </option>
	  <option name="exclusive" type="bool">
		<default>true</default>
	  </option>
	  <option name="autohide" type="bool">
		<default>false</default>
	  </option>
	  <option name="remainder" type="int">
		<default>5</default>
	  </option>
	  <option name="offset" type="int">
		<default>0</default>
	  </option>
	  <option name="autohide_duration" type="int">
		<default>300</default>
	  </option>
	  <option name="gestures_touch_only" type="bool">
		<default>false</default>
	  </option>
	  <option name="launchers" type="string">
		<default></default>
	  </option>
	</group>
  </plugin>
</wf-panel-pi>
